# ==============================================================
# HACKERANK ORCHESTRATE - AGENT ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your active API key(s)
# ==============================================================

# Primary LLM Choice: google / openrouter / groq / openai / anthropic
DEFAULT_LLM_PROVIDER=google
DEFAULT_MODEL=gemini/gemini-3.8-flash

# API Keys (Provide at least one active key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter Free Tier Model (Auto-routes to the best free model)
OPENROUTER_MODEL=openrouter/free

# Agent Execution Parameters
TEMPERATURE=0.0
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Logging & Paths
DATA_PATH=data/raw
KNOWLEDGE_BASE_PATH=data/knowledge_base
OUTPUT_PATH=outputs/output.csv
TRANSCRIPT_PATH=outputs/chat_transcript.md
